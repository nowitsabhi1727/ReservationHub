<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ReservationHub Authentication Suite">

    <listeners>
        <listener class-name="com.api.listeners.TestNGListener"/>
    </listeners>

    <test name="Authentication Tests">

        <groups>
            <run>
                <include name="auth"/>
            </run>
        </groups>

        <packages>
            <package name="com.api.tests"/>
        </packages>

    </test>

</suite>